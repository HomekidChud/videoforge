# VideoForge environment configuration (copy to .env and edit)
# Everything below is optional — a fresh local dev run needs none of it.

# --- Core ---
# Port the API + client are served on (default 5000)
# PORT=5000
# Allowed CORS origin for the API (default *; set your site origin in production)
# CORS_ORIGIN=https://your-frontend.example

# --- Storage (defaults are fine locally) ---
# SQLite database file (default data.db)
# VIDEOFORGE_DB=data.db
# Save-manifest backup directory (optional; point inside a persistent disk in production)
# VIDEOFORGE_SYNC_DIR=data/restore
# Upload / render directories (default data/media and data/renders)
# VIDEOFORGE_MEDIA_DIR=data/media
# VIDEOFORGE_RENDER_DIR=data/renders
# Max upload size in MB (default 2048)
# VIDEOFORGE_MAX_UPLOAD_MB=2048

# --- Security ---
# Bootstrap admin key for headless deployments. If set, it is seeded as the
# owner key on first boot instead of a generated key written to OWNER_KEY.txt.
# VIDEOFORGE_BOOTSTRAP_KEY=vf_admin_<random>

# --- MongoDB (optional integration store) ---
# MongoDB is NOT the application datastore (projects, media and API keys stay
# in SQLite). Setting MONGODB_URI enables a lazily-created connection for
# integrations; /api/health then reports `mongo: "configured"` (it never pings
# the cluster — liveness stays independent of the integration). Verify
# connectivity on demand with `npm run mongo:check`.
# Connection string with credentials, e.g.:
# MONGODB_URI=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true
# Database name (default videoforge)
# MONGODB_DB=videoforge
