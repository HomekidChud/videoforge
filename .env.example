# VideoForge — environment variables
#
# Copy this file to `.env` and fill in real values. `.env`, `.env.local` and
# `.env.*` are gitignored. Never commit secrets.
#
# Every variable is validated at boot by server/env.ts (Zod). The server
# exits with a clear list of every missing or invalid variable.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------

# One of: development | test | staging | production. Production enables
# stricter defaults (see server/env.ts).
APP_ENV=development

# Express environment. Controls Vite middleware vs static build.
NODE_ENV=development

# Port the HTTP server listens on. Default: 5000.
PORT=5000

# Public URL of the app (used for building share links, etc.).
# Optional; leave blank in development (blank values are normalised to unset).
APP_URL=

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------

# Comma-separated allowlist of Origins allowed to call the API
# cross-origin. Set to `none` to disable cross-origin entirely.
#
# In production this MUST be set (the server refuses to boot with it
# unset in NODE_ENV=production). Wildcards (`*`) are rejected.
#
# Examples:
#   CORS_ORIGIN=https://videoforge.example.com
#   CORS_ORIGIN=https://app.example.com,https://staging.example.com
#   CORS_ORIGIN=none
CORS_ORIGIN=

# ---------------------------------------------------------------------------
# Storage / uploads
# ---------------------------------------------------------------------------

# Path to the SQLite database file. Default: data.db
# Tests use a separate file (data.test.db) so they never touch real data.
VIDEOFORGE_DB=data.db

# Max upload size per file, in MB. Default: 2048 (2 GB).
VIDEOFORGE_MAX_UPLOAD_MB=2048

# Optional: path to a .ttf/.otf font used by the FFmpeg drawtext filter.
# If unset, FFmpeg falls back to its built-in font.
VIDEOFORGE_FONT=

# ---------------------------------------------------------------------------
# Auth / keys
# ---------------------------------------------------------------------------

# Optional: a long (≥ 32 chars) random string used as the initial admin key
# on first boot. Preferred over the generated OWNER_KEY.txt file for
# hosted deployments because it never touches disk.
#
# NOTE (rotation): changing this value adds a NEW admin key; it does NOT
# revoke previously-issued keys or media tokens. To rotate, also revoke the
# old admin key via DELETE /api/keys/:id.
#
# Generate one with:
#   openssl rand -hex 32
VIDEOFORGE_BOOTSTRAP_KEY=

# ---------------------------------------------------------------------------
# Client-side (Vite)
# ---------------------------------------------------------------------------

# Base URL of the API for the browser client. Leave blank for same-origin
# (the dev server proxies /api). Must be set only when the client is
# deployed on a different origin from the API (e.g. GitHub Pages).
#
# NOTE: this value IS baked into the client bundle, so it must never
# contain a secret.
VITE_API_BASE=
